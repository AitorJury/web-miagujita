---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const products = await getCollection("productos");
  return products.map((product: CollectionEntry<"productos">) => ({
    params: { id: product.slug },
    props: { product },
  }));
}

// Creamos la "Interfaz" para que Astro sepa qué tipo de objeto es 'product'
interface Props {
  product: CollectionEntry<"productos">;
}

const { product } = Astro.props;
const { Content } = await product.render();

const numeroWhatsApp = "34610854434";
const mensajeBase = `¡Hola Gladys! Vengo de tu web y me interesa: ${product.data.title}. ¿Me puedes dar más información?`;
const urlWhatsApp = `https://wa.me/${numeroWhatsApp}?text=${encodeURIComponent(mensajeBase)}`;
---

<Layout title={`${product.data.title} | Mi Agujita`}>
  <Header />

  <main class="max-w-7xl mx-auto px-6 py-12 md:py-24 grow">
    <a
      href="/#galeria"
      class="inline-flex items-center gap-2 text-agujita-text/60 hover:text-agujita-primary transition-colors mb-12 font-medium focus:outline-none focus:ring-2 focus:ring-agujita-primary/50 rounded-sm px-1 -ml-1"
      aria-label="Volver a la galería de trabajos"
    >
      <span class="text-xl" aria-hidden="true">←</span> Volver a la galería
    </a>

    <article
      class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20 items-center"
    >
      <div
        class="rounded-3xl overflow-hidden shadow-2xl border border-agujita-primary/10 aspect-4/5"
      >
        <Image
          src={product.data.image}
          alt={`Fotografía detallada del trabajo: ${product.data.title}`}
          transition:name={`img-${product.slug}`}
          class="w-full h-full object-cover"
        />
      </div>

      <div class="space-y-8">
        <span
          class="text-xs font-bold uppercase tracking-widest text-agujita-primary bg-agujita-primary/10 px-4 py-2 rounded-full inline-block"
        >
          Costura Creativa & Arreglos
        </span>

        <h1
          class="font-serif text-4xl md:text-5xl lg:text-6xl text-agujita-text leading-tight"
        >
          {product.data.title}
        </h1>

        <!-- Tailwind fix: h-[2px] actualizado a h-0.5 -->
        <div class="w-16 h-0.5 bg-agujita-primary/30" aria-hidden="true"></div>

        <div
          class="font-sans text-lg text-agujita-text/80 leading-relaxed space-y-4"
        >
          <Content />
        </div>

        <div class="pt-8 flex flex-col sm:flex-row gap-4">
          <a
            href={urlWhatsApp}
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 bg-agujita-text text-white rounded-full font-medium hover:bg-agujita-primary transition-all shadow-lg text-center flex items-center justify-center gap-2 focus:outline-none focus:ring-4 focus:ring-agujita-primary/50"
          >
            <span>Preguntar por este trabajo</span>
            <span class="text-xl" aria-hidden="true">💬</span>
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
